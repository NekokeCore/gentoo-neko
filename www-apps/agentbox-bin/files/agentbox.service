[Unit]
Description=agentbox containerized AI coding workbench
Documentation=https://github.com/devilcoolyue/agentbox
After=network-online.target docker.service
Wants=network-online.target docker.service
# Five failures in a minute park the unit instead of retrying forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/agentbox
ExecStart=/opt/agentbox/agentbox -config /etc/agentbox/config.json
CacheDirectory=agentbox
CacheDirectoryMode=0700
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
